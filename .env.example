# Copy to .env (gitignored). Read by the `looppp` CLI on WSL; never used in molab
# (the evaluator notebook takes the key in a password field).

# W&B API key: used for W&B Inference (LLM calls), the queue, and run logging.
WANDB_API_KEY=

# W&B team entity that owns the project (ARIA needs a team project, not a personal one).
WANDB_ENTITY=

# Optional: override configs/run.yaml queue.project
# LOOPPP_PROJECT=looppp
